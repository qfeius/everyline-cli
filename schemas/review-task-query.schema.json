{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git.qtech.cn/ai/everyline-cli/schemas/review-task-query.schema.json",
  "title": "smartAuditTaskQuery",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId"],
  "properties": {
    "taskId": {"type": "integer", "minimum": 1},
    "businessId": {"type": "string", "minLength": 1},
    "appType": {"type": "string"},
    "visibilityScope": {"enum": ["contractResult"]}
  },
  "allOf": [
    {
      "if": {
        "properties": {"visibilityScope": {"const": "contractResult"}},
        "required": ["visibilityScope"]
      },
      "then": {"required": ["businessId"]}
    }
  ]
}
