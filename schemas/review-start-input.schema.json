{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git.qtech.cn/ai/everyline-cli/schemas/review-start-input.schema.json",
  "title": "reviewTaskStartInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["businessId", "fileId", "fileHash", "config"],
  "properties": {
    "businessId": {"type": "string", "minLength": 1},
    "fileId": {"type": "integer", "minimum": 1},
    "fileHash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectedPosition", "selectedAuditRole", "reviewStrength"],
      "properties": {
        "selectedPosition": {"type": "string", "minLength": 1},
        "selectedAuditRole": {"type": "string", "minLength": 1},
        "reviewStrength": {"type": "string", "enum": ["弱势", "中立", "强势"]},
        "selectedCheckListIds": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "matchContractTypeRulePackage": {"type": "boolean"}
      },
      "anyOf": [
        {"required": ["selectedCheckListIds"]},
        {
          "required": ["matchContractTypeRulePackage"],
          "properties": {
            "matchContractTypeRulePackage": {"const": true}
          }
        }
      ]
    }
  }
}
