{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git.qtech.cn/ai/everyline-cli/schemas/review-upload.schema.json",
  "title": "uploadContractFileV3",
  "type": "object",
  "additionalProperties": false,
  "required": ["file", "name", "appType"],
  "properties": {
    "file": {"type": "string", "minLength": 1},
    "name": {"type": "string", "pattern": "(?i)\\.(doc|docx|pdf)$"},
    "appType": {"enum": ["CLM", "CR", "THIRD_PARTY"]},
    "businessId": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {"appType": {"const": "CLM"}},
        "required": ["appType"]
      },
      "then": {"required": ["businessId"]}
    }
  ]
}
