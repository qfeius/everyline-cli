{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git.qtech.cn/ai/everyline-cli/schemas/review-start-feishu.schema.json",
  "title": "FeishuSmartAuditInit",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fileId": { "type": "integer", "minimum": 1 },
    "reviewStrength": { "type": "integer", "minimum": 0, "maximum": 2, "default": 1 },
    "auditerName": { "type": "string" },
    "selectedPosition": { "type": "string", "minLength": 1 },
    "enableChapterHierarchy": { "type": "boolean", "default": false },
    "reviewRules": { "type": "string" },
    "biz1": { "type": "string" },
    "biz2": { "type": "string" },
    "biz3": { "type": "string" },
    "biz4": { "type": "string" },
    "biz5": { "type": "string" },
    "hasQuota": { "const": true },
    "baseSignature": { "type": "string", "minLength": 1 },
    "packID": { "type": "string", "minLength": 1 }
  },
  "required": ["fileId", "selectedPosition", "hasQuota", "baseSignature", "packID"]
}
