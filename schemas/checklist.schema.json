{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git.qtech.cn/ai/everyline-cli/schemas/checklist.schema.json",
  "title": "ReviewChecklist",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "contractCategory": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "reviewStage": { "type": "array", "minItems": 1, "items": { "type": "integer" } },
    "enabled": { "type": "boolean" },
    "reviewRuleIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "required": ["name", "reviewRuleIds"]
}
