{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git.qtech.cn/ai/everyline-cli/schemas/review-start.schema.json",
  "title": "smartAuditTaskStartReview",
  "type": "object",
  "additionalProperties": false,
  "required": ["businessId", "appType", "fileId", "fileHash"],
  "properties": {
    "businessId": {"type": "string", "minLength": 1},
    "appType": {"enum": ["CLM", "CR", "THIRD_PARTY"]},
    "fileId": {"type": "integer", "minimum": 1},
    "fileHash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "config": {
      "type": "object",
      "default": {},
      "properties": {
        "selectedCheckListIds": {"type": "array", "items": {"type": "string"}},
        "useSmartGeneratedChecklist": {"type": "boolean"},
        "matchContractTypeRulePackage": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "allowInvalidSelectedChecklists": {"type": "boolean", "default": false},
    "triggerScene": {"enum": ["manual", "auto"], "default": "manual"},
    "usageReportContext": {"type": "object"}
  }
}
