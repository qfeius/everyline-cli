{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git.qtech.cn/ai/everyline-cli/schemas/review-start.schema.json",
  "title": "smartAuditTaskStartReview",
  "type": "object",
  "additionalProperties": false,
  "required": ["businessId", "fileId", "fileHash", "config"],
  "properties": {
    "businessId": {"type": "string", "minLength": 1},
    "fileId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "fileHash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectedPosition", "selectedAuditRole", "reviewStrength"],
      "properties": {
        "selectedPosition": {"type": "string", "minLength": 1},
        "selectedAuditRole": {"type": "string", "minLength": 1},
        "reviewStrength": {"type": "integer", "enum": [0, 1, 2]},
        "selectedCheckListIds": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "matchContractTypeRulePackage": {"type": "boolean"}
      }
    }
  }
}
