{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git.qtech.cn/ai/everyline-cli/schemas/review-run.schema.json",
  "title": "reviewRun",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "config"],
  "properties": {
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path", "name"],
          "properties": {
            "type": {"const": "file"},
            "path": {"type": "string", "minLength": 1},
            "name": {"type": "string", "pattern": "(?i)\\.(doc|docx|pdf)$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "fileUrl", "name"],
          "properties": {
            "type": {"const": "url"},
            "fileUrl": {"type": "string", "format": "uri", "pattern": "^https?://"},
            "name": {"type": "string", "pattern": "(?i)\\.(doc|docx|pdf)$"}
          }
        }
      ]
    },
    "businessId": {"type": "string", "minLength": 1},
    "fileHash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectedPosition", "selectedAuditRole", "reviewStrength"],
      "properties": {
        "selectedPosition": {"type": "string", "minLength": 1, "description": "合同主体提取响应中所选 counterpart.name 的精确值"},
        "selectedAuditRole": {"type": "string", "minLength": 1, "description": "同一所选 counterpart.role 的精确值，例如甲方或乙方"},
        "reviewStrength": {
          "oneOf": [
            {"type": "string", "enum": ["弱势", "中立", "强势"]},
            {"type": "integer", "enum": [0, 1, 2]}
          ]
        },
        "selectedCheckListIds": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "matchContractTypeRulePackage": {"type": "boolean"}
      },
      "anyOf": [
        {"required": ["selectedCheckListIds"]},
        {
          "required": ["matchContractTypeRulePackage"],
          "properties": {
            "matchContractTypeRulePackage": {"const": true}
          }
        }
      ]
    },
    "extractSubjects": {"type": "boolean", "default": false},
    "wait": {"type": "boolean"}
  }
}
